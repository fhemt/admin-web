# Copy to .env.local for local dev. Never a NEXT_PUBLIC_ var — every
# backend call happens server-side (Server Actions / Server Components),
# so the API origin and the JWT never need to reach client-side JS.
#
# Whatever's deployed (no Azure hosting target for admin-web yet — see
# infrastructure/terraform/README.md) should set this to the matching
# backend: https://api-staging.fhemt.ma for staging, https://api.fhemt.ma
# for prod. Local dev keeps the localhost default below.
API_URL=http://localhost:8080
